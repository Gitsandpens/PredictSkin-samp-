# Optional settings (backend reads these from the environment). Defaults work out of the box.
MODEL_NAME=mobilenet_v2        # or resnet50
SOFTMAX_TEMPERATURE=0.05       # lower = sharper percentages
MIN_COSINE=0.55                # best cosine below this -> "Uncertain Result"
MIN_MARGIN=0.03                # best minus second-best below this -> "Uncertain Result"
ALLOWED_ORIGINS=http://localhost:5173
# Frontend (set when deploying): URL of the deployed backend
# VITE_API_URL=https://your-backend.example.com
